{
  "id": 21,
  "titre": "An der Wunneng",
  "titre_fr": "Les meubles et objets de la maison",
  "couleur": "#b5835a",
  "instructions": {
    "flashcards": "Mot caché : retrouve l'objet luxembourgeois à partir du français, pièce par pièce. L'article (e, en, eng) est affiché ; la note donne le genre et un exemple avec une préposition.",
    "quiz": "Lis un objet, un pluriel, une pièce ou une phrase en luxembourgeois et choisis la bonne traduction française. Distracteurs : objets de la même pièce, pluriel, autre préposition.",
    "trous": "Complète la phrase avec l'objet, la pièce ou la préposition qui correspond à la traduction (prépositions de la leçon 20).",
    "ecriture": "Phrases complètes pour dire où se trouve un objet, et la question Wou ass …?"
  },
  "unites": [
    {
      "id": 1,
      "titre": "La cuisine",
      "regle": "Apprends chaque objet <b>avec son article</b> : e, en ou eng",
      "exemple": "<b>en</b> Teller = une assiette · <b>eng</b> Pan = une poêle",
      "phrases": [
        [
          "D'Glas ass am Frigo.",
          "Le verre est dans le frigo."
        ],
        [
          "Wou ass d'Pan?",
          "Où est la poêle ?"
        ]
      ],
      "pieges": [
        "<b>en</b> Teller, <b>en</b> Dëppen : masculins (≠ une assiette, une casserole).",
        "<b>e Spullsteen</b> = évier (cuisine) ≠ <b>e Lavabo</b> = lavabo (salle de bain)."
      ]
    },
    {
      "id": 2,
      "titre": "Le salon",
      "regle": "Après une préposition : féminin → <b>der</b> · masculin et neutre → <b>dem</b>",
      "exemple": "op <b>der</b> Kommod · virum (virun + <b>dem</b>) Kannapee",
      "phrases": [
        [
          "D'Planz ass op der Kommod.",
          "La plante est sur la commode."
        ],
        [
          "Den Dësch ass virum Kannapee.",
          "La table est devant le canapé."
        ]
      ],
      "pieges": [
        "<b>eng Fotell</b> : féminin (≠ un fauteuil).",
        "<b>en Dësch</b> : masculin · <b>e Regal</b> : neutre."
      ]
    },
    {
      "id": 3,
      "titre": "La salle de bain",
      "regle": "Contractions : <b>an + dem = am</b> · <b>op + dem = um</b>",
      "exemple": "<b>am</b> Buedzëmmer · <b>um</b> Lavabo",
      "phrases": [
        [
          "De Becher ass um Lavabo.",
          "Le gobelet est sur le lavabo."
        ],
        [
          "D'Bidden ass am Buedzëmmer.",
          "La baignoire est dans la salle de bain."
        ]
      ],
      "pieges": [
        "<b>an + dem = am</b> · <b>op + dem = um</b> : am Buedzëmmer, um Lavabo.",
        "Féminin → <b>der</b> : nieft der Dusch, op der Bidden."
      ]
    },
    {
      "id": 4,
      "titre": "La chambre",
      "regle": "Pour demander où est un objet : <b>Wou ass …?</b>",
      "exemple": "Wou ass d'Luucht? → <b>D'Luucht ass um Nuetsdësch.</b>",
      "phrases": [
        [
          "Den Teppech ass ënnert dem Bett.",
          "Le tapis est sous le lit."
        ],
        [
          "Wou ass d'Bett?",
          "Où est le lit ?"
        ]
      ],
      "pieges": [
        "<b>Wou</b> ass …? = Où est … ? (<b>Wat</b> = quoi).",
        "<b>ënnert dem</b> Bett = sous le lit · <b>iwwert dem</b> Bett = au-dessus du lit."
      ]
    }
  ],
