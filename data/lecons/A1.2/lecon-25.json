  "unites": [
    {
      "id": 1,
      "titre": "Demander ce qu'on veut acheter",
      "phrase": [
        "Wat kritt Dir? – Ech hätt gär e Kilo Äppel.",
        "Que désirez-vous ? – Je voudrais un kilo de pommes."
      ],
      "regle": "Au marché, la vendeuse demande <b>Wat kritt Dir?</b> ; le client répond <b>Ech hätt gär …</b> ou <b>Ech huelen …</b>.",
      "exemple": "Ech hätt gär e Kilo Äppel. · Soss nach eppes?",
      "pieges": [
        "<b>Wat kritt Dir?</b> est la question de la vendeuse.",
        "<b>Ech hätt gär</b> est une demande polie, sans traduction mot à mot."
      ]
    },
    {
      "id": 2,
      "titre": "Les quantités et les produits",
      "phrase": [
        "Ech hätt gär dräi Pond Gromperen.",
        "Je voudrais trois livres (1,5 kg) de pommes de terre."
      ],
      "regle": "Une quantité : <b>e Kilo</b> (1 kg), <b>e Pond</b> (500 g), <b>eng Dosen</b> (12), <b>eng Tut</b> (sachet).",
      "exemple": "Ech huelen eng Dosen Aprikosen.",
      "pieges": [
        "<b>e Pond</b> = 500 g, pas 1 kg.",
        "Les produits sont généralement au pluriel après une quantité : <b>Äppel</b>, <b>Gromperen</b>."
      ]
    },
    {
      "id": 3,
      "titre": "Terminer et payer",
      "phrase": [
        "Kann ech mat der Kaart bezuelen? – Jo, dat geet.",
        "Puis-je payer par carte ? – Oui, c'est possible."
      ],
      "regle": "Pour conclure : <b>Dat wier alles.</b> Pour régler : <b>Kann ech mat der Kaart bezuelen?</b> ou <b>Ech bezuele boer.</b>",
      "exemple": "Dat mécht zesummen aacht Euro. · Ech bezuele mat der Kaart.",
      "pieges": [
        "<b>mat der Kaart</b> = par carte ; <b>boer</b> = en liquide.",
        "<b>zesummen</b> annonce le total, <b>bezuelen</b> l'action de payer."
      ]
    }
