{
  "id": 8,
  "titre": "D'Nationalitéit",
  "titre_fr": "Les nationalités",
  "couleur": "#7ab8e8",
  "instructions": {
    "flashcards": "Mot caché : une carte par forme. Retrouve la nationalité luxembourgeoise (sans article) à partir du français ; l'indice donne le genre.",
    "quiz": "Nationalité française avec le genre. Choisis la forme luxembourgeoise avec son article. Distracteurs : l'autre genre, le pays, la langue.",
    "trous": "Phrase avec un prénom masculin ou féminin : retrouve la nationalité, ou la négation (kee / keng) dans l'unité 3.",
    "ecriture": "Phrases complètes : Hien ass …, Si ass …, Ech si …, questions (Ass hien …?, Wat ass seng / hir Nationalitéit?) et négations."
  },
  "unites": [
    {
      "id": 1,
      "titre": "Les pays voisins",
      "regle": "Féminin = masculin + <b>-in</b>",
      "exemple": "Fransous → Fransous<b>in</b> · sauf <b>Belsch</b> (invariable) et <b>Däitschen / Däitsch</b>",
      "phrases": [
        [
          "Hien ass Lëtzebuerger.",
          "Il est luxembourgeois."
        ],
        [
          "Si ass Fransousin.",
          "Elle est française."
        ]
      ]
    },
    {
      "id": 2,
      "titre": "Le reste de l'Europe",
      "regle": "Dire la nationalité : <b>pas d'article</b>",
      "exemple": "<b>Hien ass</b> Spuenier. · <b>Si ass</b> Italienerin.",
      "phrases": [
        [
          "Hien ass Spuenier.",
          "Il est espagnol."
        ],
        [
          "Si ass Englännerin.",
          "Elle est anglaise."
        ]
      ]
    },
    {
      "id": 3,
      "titre": "Le reste du monde",
      "regle": "Négation : <b>kee</b> (masculin) · <b>keng</b> (féminin)",
      "exemple": "Hien ass <b>kee</b> Chinees. · Si ass <b>keng</b> Amerikanerin.",
      "phrases": [
        [
          "Wat ass seng Nationalitéit?",
          "Quelle est sa nationalité ? (à lui)"
        ],
        [
          "Ass si Japanerin?",
          "Est-elle japonaise ?"
        ]
      ]
    }
  ],
