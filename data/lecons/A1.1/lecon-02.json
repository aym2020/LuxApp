{
  "id": 2,
  "titre": "Objeten identifizéieren",
  "titre_fr": "Identifier des objets – articles indéfinis",
  "couleur": "#5a8fd4",
  "instructions": {
    "flashcards": "Mot caché : retrouve le nom luxembourgeois à partir du français. L'article (e, en, eng) est affiché pour le mémoriser avec le mot.",
    "quiz": "Lis le mot français et choisis la bonne forme luxembourgeoise (bon article + nom). Dans l'unité 3, choisis la bonne négation.",
    "trous": "Complète avec l'article ou la négation correcte (e, en, eng, kee, keen, keng) selon le genre du nom.",
    "ecriture": "Traduis la phrase en luxembourgeois : Dat ass …, Ass dat …?, Jo / Nee, avec le bon article ou la bonne négation."
  },
  "unites": [
    {
      "id": 1,
      "titre": "Masculin : e ou en",
      "regle": "Masculin : <b>e</b>, ou <b>en</b> devant une voyelle ou n, d, t, z, h",
      "exemple": "<b>e</b> Bus · <b>en</b> Dësch · <b>en</b> Auto",
      "phrases": [
        [
          "Dat ass e Bus.",
          "C'est un bus."
        ],
        [
          "Dat ass en Dësch.",
          "C'est une table."
        ]
      ]
    },
    {
      "id": 2,
      "titre": "Féminin : eng",
      "regle": "Féminin : toujours <b>eng</b>",
      "exemple": "<b>eng</b> Dier · <b>eng</b> Fläsch · <b>eng</b> Mapp (un sac)",
      "phrases": [
        [
          "Dat ass eng Dier.",
          "C'est une porte."
        ],
        [
          "Ass dat eng Fläsch?",
          "Est-ce une bouteille ?"
        ]
      ]
    },
    {
      "id": 3,
      "titre": "Neutre et négation",
      "regle": "Neutre comme masculin : <b>e</b> / <b>en</b>. Négation : <b>kee</b> · <b>keen</b> · <b>keng</b>",
      "exemple": "e Buch → <b>kee</b> Buch · en Haus → <b>keen</b> Haus · eng Dier → <b>keng</b> Dier",
      "phrases": [
        [
          "Nee, dat ass kee Buch.",
          "Non, ce n'est pas un livre."
        ],
        [
          "Nee, dat ass keng Dier.",
          "Non, ce n'est pas une porte."
        ]
      ]
    }
  ],
