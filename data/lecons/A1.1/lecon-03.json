      "regle": "Une couleur se nie avec <b>net</b> : De Bus ass <b>net</b> rosa. · Il / elle : <b>en</b> (m.), <b>si</b> (f.), <b>et</b> (n.)",
      "exemple": "Nee, de Stëft ass net rout. · En ass blo. · D'Fënster ass brong. → Si ass brong.",
      "phrases": [
        [
          "De Bus ass net rosa.",
          "Le bus n'est pas rose."
        ],
        [
          "D'Blat ass wäiss. → Et ass wäiss.",
          "La feuille est blanche. → Elle est blanche."
        ]
      ],
      "pieges": [
        "Couleur = adjectif → <b>net</b>, jamais kee / keng (qui nient un nom, leçon 2).",
        "Le pronom suit le genre luxembourgeois : de Stëft → <b>en</b>, d'Mapp → <b>si</b>, d'Buch → <b>et</b>."
      ]
    }
