  "instructions": {
    "flashcards": "Mot caché : retrouve la couleur ou le mot luxembourgeois à partir du français.",
    "quiz": "Lis la couleur ou la phrase luxembourgeoise et choisis la bonne traduction française.",
    "trous": "Complète avec la bonne couleur, avec a / an pour relier deux couleurs, ou avec net pour dire non.",
    "ecriture": "Écris en luxembourgeois les phrases de la mission : demander et dire la couleur d'un objet, relier deux couleurs, dire qu'un objet n'est pas d'une couleur."
  },
  "mission": {
    "titre": "Aux objets trouvés",
    "contexte": "Tu as oublié ton sac et ton stylo dans le bus. Au bureau des objets trouvés, l'employée te demande de les décrire.",
    "objectif": "demander et dire la couleur d'un objet, relier deux couleurs, dire qu'un objet n'est pas d'une couleur."
  },
  "scene": [
    {
      "qui": "L'employée",
      "lu": "Moien! Wat fir eng Faarf huet d'Mapp?",
      "fr": "Bonjour ! De quelle couleur est le sac ?",
      "unite": 1
    },
    {
      "qui": "toi",
      "lu": "D'Mapp ass schwaarz.",
      "fr": "Le sac est noir.",
      "unite": 1,
      "aide": "<b>D'</b>Mapp (féminin) + <b>ass</b> + la couleur, sans accord."
    },
    {
      "qui": "L'employée",
      "lu": "Ass d'Mapp schwaarz a brong?",
      "fr": "Le sac est-il noir et marron ?",
      "unite": 2
    },
    {
      "qui": "toi",
      "lu": "Jo, d'Mapp ass schwaarz a brong.",
      "fr": "Oui, le sac est noir et marron.",
      "unite": 2,
      "aide": "Et = <b>an</b>, mais <b>a</b> devant b : schwaarz <b>a</b> brong."
    },
    {
      "qui": "L'employée",
      "lu": "An de Stëft? Ass de Stëft rout?",
      "fr": "Et le stylo ? Le stylo est-il rouge ?",
      "unite": 3
    },
    {
      "qui": "toi",
      "lu": "Nee, en ass net rout. En ass blo.",
      "fr": "Non, il n'est pas rouge. Il est bleu.",
      "unite": 3,
      "aide": "Une couleur se nie avec <b>net</b> · de Stëft (masculin) → <b>en</b>."
    },
    {
      "qui": "L'employée",
      "lu": "Hei ass de Stëft!",
      "fr": "Voici le stylo !",
      "unite": 3
    }
  ],
  "unites": [
