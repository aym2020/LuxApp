    {
      "id": 2,
      "titre": "Poser la question, relier deux couleurs",
      "phrase": [
        "Ass d'Mapp schwaarz a brong? – Jo, d'Mapp ass schwaarz a brong.",
        "Le sac est-il noir et marron ? – Oui, le sac est noir et marron."
      ],
      "regle": "Question : le verbe en premier, <b>Ass</b> d'Mapp schwaarz? · Oui : <b>Jo</b>, … · Et : <b>an</b>, ou <b>a</b> devant la plupart des consonnes",
      "exemple": "Ass de Bus gréng? – Jo, de Bus ass gréng. · schwaarz <b>a</b> brong · brong <b>an</b> orange",
      "phrases": [
        [
          "Ass de Bus gréng?",
          "Est-ce que le bus est vert ?"
        ],
        [
          "Den Dësch ass brong a wäiss.",
          "La table est marron et blanche."
        ]
      ],
      "pieges": [
        "<b>an</b> devient <b>a</b> devant la plupart des consonnes : schwaarz <b>a</b> wäiss (comme e / en, leçon 2).",
        "Question oui / non : <b>Ass</b> vient en premier, sans mot interrogatif."
      ]
    },
    {
      "id": 3,
      "titre": "Dire non, remplacer l'objet",
      "phrase": [
        "Nee, en ass net rout. En ass blo.",
        "Non, il n'est pas rouge. Il est bleu."
