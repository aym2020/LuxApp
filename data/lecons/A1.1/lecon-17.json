  "instructions": {
    "flashcards": "Mot caché : mémorise les jours, les expressions courtes de prise de rendez-vous et les formules de politesse.",
    "quiz": "Lis les jours et expressions luxembourgeois et reconnais leur traduction française parmi des distracteurs plausibles.",
    "trous": "Complète avec le jour, l'expression de proposition, de refus, de confirmation ou de politesse attendue.",
    "ecriture": "Produis en luxembourgeois les jours, les propositions de rendez-vous, les questions et les phrases de politesse. Aucune abréviation non précisée n'est exigée."
  },
  "mission": {
    "titre": "Téléphoner pour un rendez-vous",
    "contexte": "Tu téléphones à Madame Molitor pour prendre un rendez-vous. Tu joues Paul et tu dois proposer vendredi, confirmer l'horaire et donner ton nom.",
    "objectif": "demander un rendez-vous, proposer un jour, confirmer et terminer poliment l'appel."
  },
  "scene": [
