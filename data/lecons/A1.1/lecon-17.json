  "unites": [
    {
      "id": 1,
      "titre": "Les jours et demander un rendez-vous",
      "phrase": [
        "Ech hätt gär e Rendez-vous.",
        "Je voudrais un rendez-vous."
      ],
      "regle": "Pour demander poliment : <b>Ech hätt gär e Rendez-vous.</b> Les jours vont de Méindeg à Sonndeg.",
      "exemple": "Ech hätt gär e Rendez-vous · Méindeg, Dënschdeg, Mëttwoch, Donneschdeg, Freideg.",
      "pieges": [
        "<b>hätt gär</b> est une formule polie : « je voudrais ».",
        "Les jours s'écrivent avec une majuscule : <b>Freideg</b>."
      ]
    },
    {
      "id": 2,
      "titre": "Proposer, refuser et confirmer",
      "phrase": [
        "Fir e Freideg, geet dat? – Jo, dat ass an der Rei.",
        "Pour vendredi, est-ce que ça va ? – Oui, c'est d'accord."
      ],
      "regle": "Pour proposer : <b>Fir e Freideg, geet dat?</b> Réponses : <b>Dat geet leider net</b> (non) ou <b>Dat ass an der Rei</b> (oui).",
      "exemple": "Fir wéini? · Dat geet leider net. · Jo, dat ass an der Rei.",
      "pieges": [
        "<b>leider net</b> marque un refus, <b>an der Rei</b> une acceptation.",
        "En écriture, ne demande pas une <b>abréviation</b> qui n'est pas indiquée en français."
      ]
    },
    {
      "id": 3,
      "titre": "Nom et formules de politesse",
      "phrase": [
        "Wéi ass Ären Numm? – Mäin Numm ass Paul.",
        "Quel est votre nom ? – Mon nom est Paul."
      ],
      "regle": "Question formelle : <b>Wéi ass Ären Numm?</b> · Pour finir : <b>Villmools Merci!</b>, <b>Bis d'nächst Woch</b>.",
      "exemple": "Wéi buschtawéiert Dir dat? · Villmools Merci! · Et ass gär geschitt!",
      "pieges": [
        "<b>Ären</b> et <b>Dir</b> prennent une majuscule de politesse.",
        "<b>Mäin Numm ass …</b> (mon nom est) est distinct de <b>Ech heeschen …</b> (je m'appelle)."
      ]
    }
  ],
