    {
      "id": 2,
      "titre": "Les enfants",
      "phrase": [
        "Hues du Kanner? – Jo, ech hunn zwee Kanner.",
        "As-tu des enfants ? – Oui, j'ai deux enfants."
      ],
      "regle": "<b>e Kand</b> (un enfant), <b>Kanner</b> (des enfants) ; <b>hunn</b> (avoir).",
      "exemple": "Ech hunn <b>zwee Kanner</b> · Ech hu <b>keng Kanner</b>.",
      "pieges": [
        "Un enfant = e Kand ; des enfants = <b>Kanner</b>.",
        "La négation du pluriel utilise <b>keng</b>."
      ]
    },
    {
