      "titre": "Marié, divorcé ou célibataire ?",
      "phrase": [
        "Bass du bestuet? – Nee, ech sinn net bestuet.",
        "Es-tu marié ? – Non, je ne suis pas marié."
      ],
      "regle": "Situation familiale : <b>bestuet</b>, <b>gescheet</b>, <b>leedeg</b> · négation : <b>net bestuet</b>.",
      "exemple": "<b>Bass du bestuet?</b> (tu) · <b>Sidd Dir bestuet?</b> (vous).",
      "pieges": [
        "On nie un état avec <b>net</b>, pas kee.",
        "<b>leedeg</b> et <b>e Jonggesell</b> ne sont pas la même structure."
      ]
