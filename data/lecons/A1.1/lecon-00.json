  "instructions": {
    "flashcards": "Écoute les mots luxembourgeois enregistrés, puis retrouve leur orthographe. Unité 2 : mémorise quelques exemples courts de la règle du N.",
    "quiz": "Unité 1 : appuie sur le haut-parleur et retrouve l'écriture entendue ; unité 2 : reconnais la bonne forme avec ou sans N.",
    "trous": "Complète les petites phrases avec le mot appris ou la forme correcte du N ; les lettres et mots nécessaires sont dans le cours.",
    "ecriture": "À partir du français, écris les mots appris puis les courtes expressions et groupes nominaux enseignés dans le cours. La consigne distingue les articles indéfinis et définis."
  },
  "unites": [
    {
      "id": 1,
      "titre": "Prononciation",
      "phrase": [
        "Jo!",
        "Oui !"
      ],
      "regle": "Quelques graphies se lisent autrement qu’en français : <b>W</b> ≈ V, <b>J</b> ≈ Y, <b>Z</b> ≈ TS, <b>SCH</b> ≈ CH, <b>ST</b> initial ≈ CHT. Pour <b>CH, Ë, Ä et ÉI</b>, écoute surtout les enregistrements.",
      "exemple": "wäiss · Jo · zéng · Schoul · Stull · Buch · Fënster · Äddi! · schéin",
      "pieges": [
        "Chaque mot possède un enregistrement LOD : écoute-le dans le lexique et répète.",
        "Les repères français sont approximatifs : ne te fie pas seulement aux lettres."
      ]
    },
    {
      "id": 2,
      "titre": "United Zoha",
      "phrase": [
        "Gudde Moien!",
        "Bonjour ! (formule du matin)"
      ],
      "regle": "Dans certaines terminaisons, le <b>N final</b> reste devant une voyelle ou <b>N, D, T, Z, H</b> (United Zoha). Il tombe devant la plupart des autres consonnes et reste en fin d'énoncé.",
      "exemple": "Gudde Moien! / Gudden Owend! · e Stull / en Auto · de Bus / den Auto",
      "pieges": [
        "Cette règle concerne certaines terminaisons ; ne supprime pas le N au milieu des mots.",
        "Auto et Dësch sont masculins en luxembourgeois, même si leurs traductions françaises sont féminines. Les articles seront approfondis dans la leçon 2."
      ]
    }
  ],
