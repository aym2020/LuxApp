{
  "id": 0,
  "titre": "Déi éischt Schrëtt",
  "titre_fr": "Bien démarrer : les sons et la règle du N",
  "couleur": "#4acfa6",
  "instructions": {
    "flashcards": "Écoute les mots luxembourgeois enregistrés, puis retrouve leur orthographe. Unité 2 : mémorise quelques exemples courts de la règle du N.",
    "quiz": "Unité 1 : appuie sur le haut-parleur et retrouve l'écriture entendue ; unité 2 : reconnais la bonne forme avec ou sans N.",
    "trous": "Complète les petites phrases avec le mot appris ou la forme correcte du N ; les lettres et mots nécessaires sont dans le cours.",
    "ecriture": "À partir du français, écris les mots appris puis les courtes expressions et groupes nominaux enseignés dans le cours. La consigne distingue les articles indéfinis et définis."
  },
  "unites": [
    {
      "id": 1,
      "titre": "Les sons différents du français",
      "phrase": [
        "Jo!",
        "Oui !"
      ],
      "regle": "Écoute avant de lire : <b>w</b> se prononce comme v, <b>j</b> comme y, <b>z</b> comme ts, <b>sch</b> comme ch ; <b>st</b> en début de mot se prononce cht. <b>ch</b>, <b>ë</b>, <b>ä</b> et <b>éi</b> demandent aussi de l'écoute.",
      "exemple": "wäiss · Jo · zéng · Schoul · Stull · Buch · Fënster · Äddi! · schéin",
      "pieges": [
        "Appuie sur le haut-parleur : tous les mots proposés possèdent déjà un enregistrement LOD.",
        "Les indications françaises sont des repères, pas des transcriptions exactes."
      ]
    },
    {
      "id": 2,
      "titre": "UNITEDZOHA : la règle du N",
      "phrase": [
        "Gudde Moien!",
        "Bonjour ! (formule du matin)"
      ],
      "regle": "Dans les mots concernés, le <b>n final</b> reste devant une voyelle ou <b>N, D, T, Z, H</b> (UNITEDZOHA) et tombe devant les autres consonnes. En fin de phrase, on le conserve.",
      "exemple": "Gudde Moien! / Gudden Owend! · e Stull / en Auto · de Bus / den Auto",
      "pieges": [
        "La règle concerne des terminaisons qui alternent : on ne retire pas le N de tous les mots.",
        "Le féminin utilise <b>eng</b> (indéfini) ou <b>d'</b> (défini) : la règle e/en ou de/den concerne ici le masculin et le neutre ou le masculin selon l'article."
      ]
    }
  ],
