      "aide": "Au vouvoiement : <b>schwätzt Dir</b>?"
    },
    {
      "qui": "Madamm Klein",
      "lu": "Ech schwätzen Hollännesch an Englesch.",
      "fr": "Je parle néerlandais et anglais.",
      "unite": 2
    }
