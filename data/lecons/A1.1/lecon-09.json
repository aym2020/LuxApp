  "unites": [
    {
      "id": 1,
      "titre": "Dire les langues qu'on parle",
      "phrase": [
        "Ech schwätze Franséisch an Lëtzebuergesch.",
        "Je parle français et luxembourgeois."
      ],
      "regle": "Une langue reste invariable. Avec « je », on dit <b>Ech schwätzen</b> ; avec « il / elle », <b>Hien / Si schwätzt</b>.",
      "exemple": "Ech schwätze <b>Franséisch</b> an <b>Lëtzebuergesch</b>.",
      "pieges": [
        "Une langue n'est pas une nationalité : Franséisch ≠ Fransous.",
        "On ne met pas d'article devant le nom d'une langue."
      ]
    },
    {
      "id": 2,
      "titre": "Demander et répondre non",
      "phrase": [
        "Wat fir eng Sprooch schwätzt du? – Ech schwätzen e bësse Lëtzebuergesch.",
        "Quelle langue parles-tu ? – Je parle un peu luxembourgeois."
      ],
      "regle": "Question : <b>Wat fir eng Sprooch schwätzt du?</b> · Négation : <b>schwätzt net</b> + langue.",
      "exemple": "Ech schwätzen <b>e bësse</b> Lëtzebuergesch · Hien schwätzt <b>net</b> Däitsch.",
      "pieges": [
        "<b>net</b> nie le verbe : il ne parle pas allemand = Hien schwätzt net Däitsch.",
        "<b>e bësse</b> signifie « un peu » et précède la langue."
      ]
    }
  ],
