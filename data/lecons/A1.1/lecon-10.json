  "instructions": {
    "flashcards": "Mot caché : retrouve une formule courte pour dire ou demander où l'on habite.",
    "quiz": "Choisis la bonne préposition ou la bonne expression pour indiquer son lieu d'habitation.",
    "trous": "Complète avec zu, a, an, an der, um ou am selon le lieu.",
    "ecriture": "Traduis en luxembourgeois les phrases « J'habite… », « Où habites-tu ? » et les variantes de pays, villes et quartiers."
  },
  "mission": {
    "titre": "Où habites-tu ?",
    "contexte": "Tu rencontres Marie, une collègue, qui veut savoir dans quel pays et dans quelle ville tu habites. Vous parlez aussi de vos collègues et des quartiers de Luxembourg, puis tu poses la question à Monsieur Weber.",
    "objectif": "dire où tu habites, demander le lieu d'habitation et choisir la préposition adaptée.",
    "version": 2
  },
  "scene": [
    {
      "qui": "Marie",
      "lu": "Moien! Wou wunns du?",
      "fr": "Bonjour ! Où habites-tu ?",
      "unite": 1
    },
    {
      "qui": "toi",
      "lu": "Ech wunnen a Frankräich.",
      "fr": "J'habite en France.",
      "unite": 1,
      "aide": "Pour la France, utilise <b>a Frankräich</b>."
    },
    {
      "qui": "Marie",
      "lu": "Ech wunnen an der Belsch. An de Paul?",
      "fr": "Moi, j'habite en Belgique. Et Paul ?",
      "unite": 1
    },
    {
      "qui": "toi",
      "lu": "De Paul wunnt zu Lëtzebuerg.",
      "fr": "Paul habite au Luxembourg.",
      "unite": 1,
      "aide": "Pour le Luxembourg (pays), utilise <b>zu</b>."
    },
    {
      "qui": "Marie",
      "lu": "An d'Anna?",
