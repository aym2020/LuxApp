    {
      "id": 1,
      "titre": "Habiter dans un pays",
      "phrase": [
        "Ech wunnen a Frankräich.",
        "J'habite en France."
      ],
      "regle": "Pays : <b>zu Lëtzebuerg</b>, <b>a Frankräich</b>, <b>an Däitschland</b>, <b>an der Belsch</b>.",
      "exemple": "<b>Ech wunnen</b> = j'habite ; <b>hien / si wunnt</b> = il / elle habite.",
      "pieges": [
        "On dit <b>zu Lëtzebuerg</b> pour le pays, mais <b>a Frankräich</b>.",
        "La Belsch et Schwäiz prennent <b>an der</b>."
      ]
    },
    {
      "id": 2,
      "titre": "Villes, quartiers et questions",
      "phrase": [
        "Wou wunns du? – Ech wunnen zu Metz.",
        "Où habites-tu ? – J'habite à Metz."
      ],
      "regle": "Ville : <b>zu</b> Metz, zu Esch · Quartier : <b>um</b> Kirchberg, <b>am</b> Gronn.",
      "exemple": "<b>Wou wunns du?</b> (tu) · <b>Wou wunnt Dir?</b> (vous, politesse).",
      "pieges": [
        "Le français « à » ne se traduit pas partout pareil : ville = <b>zu</b>, quartier souvent <b>um / am</b>.",
        "<b>Dir</b> avec majuscule est la forme de politesse."
      ]
    }
