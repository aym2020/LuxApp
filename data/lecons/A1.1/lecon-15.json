      "unite": 1
    },
    {
      "qui": "toi",
      "lu": "Et ass zwou Auer.",
      "fr": "Il est deux heures.",
      "unite": 1,
      "aide": "Pour deux heures, rappelle-toi le féminin de <b>Auer</b> : <b>zwou</b>."
    },
    {
