  "mission": {
    "titre": "À la brocante",
    "contexte": "Tu cherches un vélo à la brocante. La vendeuse vante un vieux vélo, puis une table et un téléphone : à chaque qualité, tu réponds par le contraire… sauf pour le téléphone.",
    "objectif": "décrire un objet avec un adjectif et répondre par son contraire.",
    "version": 2
  },
  "scene": [
    {
      "qui": "La vendeuse",
      "lu": "Moien! De Vëlo ass nei!",
      "fr": "Bonjour ! Le vélo est neuf !",
