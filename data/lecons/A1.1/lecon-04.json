  "cours": [
    {
      "type": "texte",
      "contenu": "Cette leçon présente des adjectifs et leurs <b>contraires</b>. L'adjectif se place après <b>ass</b> et reste <b>invariable</b> : <b>De Bus ass grouss.</b> Un contraire se retient mieux à deux : si tu connais <b>grouss</b>, tu connais <b>kleng</b>."
    },
