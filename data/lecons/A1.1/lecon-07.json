{
  "id": 7,
  "titre": "Persoune presentéieren",
  "titre_fr": "Présenter des personnes – l'origine",
  "couleur": "#d46fc4",
  "v1": {
    "quiz": 18,
    "trous": 16,
    "ecriture": 44
  },
  "instructions": {
    "flashcards": "Mot caché : retrouve le pays ou l'expression d'origine en luxembourgeois à partir du français. Les mots supplémentaires figurent dans « + ».",
    "quiz": "Lis le pays ou l'expression en français, puis choisis la forme luxembourgeoise. Les distracteurs sont des pays ou des prépositions proches.",
    "trous": "Complète la provenance avec aus, vu, vum, aus der ou aus dem selon le pays.",
    "ecriture": "Traduis du français vers le luxembourgeois : pays, questions d'origine et phrases complètes avec kommen."
  },
  "mission": {
    "titre": "Faire connaissance au centre de langues",
    "contexte": "Tu rencontres Marie à la pause d'un cours de luxembourgeois. Vous parlez de vos pays d'origine et de ceux des autres élèves.",
    "objectif": "dire d'où tu viens, choisir la préposition devant le pays et demander l'origine d'une personne.",
    "version": 2
  },
  "scene": [
    {
      "qui": "Marie",
      "lu": "Moien! Vu wou kënns du?",
      "fr": "Bonjour ! D'où viens-tu ?",
      "unite": 1
    },
    {
      "qui": "toi",
      "lu": "Ech kommen aus Frankräich.",
      "fr": "Je viens de France.",
      "unite": 1,
      "aide": "Pour la France, utilise <b>aus</b>."
    },
    {
      "qui": "Marie",
      "lu": "De Paul kënnt aus Portugal.",
      "fr": "Paul vient du Portugal.",
      "unite": 1
    },
    {
      "qui": "toi",
      "lu": "An d'Anna kënnt aus Däitschland.",
      "fr": "Et Anna vient d'Allemagne.",
      "unite": 1,
      "aide": "Pour l'Allemagne, on utilise <b>aus</b>."
    },
    {
      "qui": "Marie",
      "lu": "An d'Greta?",
      "fr": "Et Greta ?",
      "unite": 1
    },
    {
      "qui": "toi",
      "lu": "D'Greta kënnt aus Schweden.",
      "fr": "Greta vient de Suède.",
      "unite": 1,
      "aide": "<b>kënnt aus</b> + pays : aus Schweden."
    },
    {
      "qui": "Marie",
      "lu": "An den Emmanuel?",
      "fr": "Et Emmanuel ?",
      "unite": 1
    },
    {
      "qui": "toi",
      "lu": "Den Emmanuel kënnt aus Frankräich.",
      "fr": "Emmanuel vient de France.",
      "unite": 1,
      "aide": "<b>Den</b> devant une voyelle : den Emmanuel."
    },
    {
      "qui": "Marie",
      "lu": "Kënns du aus Spuenien?",
      "fr": "Tu viens d'Espagne ?",
      "unite": 1
    },
    {
      "qui": "toi",
      "lu": "Nee, ech kommen aus Frankräich.",
      "fr": "Non, je viens de France.",
      "unite": 1,
      "aide": "Non = <b>Nee</b> · ech <b>kommen</b>, hien <b>kënnt</b>."
    },
    {
      "qui": "toi",
      "lu": "Vu wou kënnt de Guillaume?",
      "fr": "D'où vient Guillaume ?",
      "unite": 2,
      "aide": "Pour demander l'origine d'un homme : <b>Vu wou kënnt</b> … ?"
    },
    {
      "qui": "Marie",
      "lu": "De Guillaume kënnt vu Lëtzebuerg.",
      "fr": "Guillaume vient du Luxembourg.",
      "unite": 2
    },
    {
      "qui": "Marie",
      "lu": "A vu wou kënnt d'Julie?",
      "fr": "Et d'où vient Julie ?",
      "unite": 2
    },
    {
      "qui": "toi",
      "lu": "D'Julie kënnt aus der Belsch.",
      "fr": "Julie vient de Belgique.",
      "unite": 2,
      "aide": "Avec la Belgique, <b>aus der</b> Belsch."
    },
    {
      "qui": "Marie",
      "lu": "An d'Shirin?",
      "fr": "Et Shirin ?",
      "unite": 2
    },
    {
      "qui": "toi",
      "lu": "Si kënnt aus dem Iran.",
      "fr": "Elle vient d'Iran.",
      "unite": 2,
      "aide": "L'Iran est masculin : <b>aus dem</b> Iran."
    },
    {
      "qui": "Marie",
      "lu": "An d'Olena?",
      "fr": "Et Olena ?",
      "unite": 2
    },
    {
      "qui": "toi",
      "lu": "Si kënnt aus der Ukrain.",
      "fr": "Elle vient d'Ukraine.",
      "unite": 2,
      "aide": "L'Ukraine est féminin : <b>aus der</b> Ukrain."
    },
    {
      "qui": "Marie",
      "lu": "An de Paulo?",
      "fr": "Et Paulo ?",
      "unite": 2
    },
    {
      "qui": "toi",
      "lu": "Hie kënnt vum Cap Vert.",
      "fr": "Il vient du Cap-Vert.",
      "unite": 2,
      "aide": "Une île : <b>vum</b> Cap Vert · <b>hie</b> (le n tombe devant k)."
    }
  ],
  "unites": [
    {
      "id": 1,
      "titre": "Dire d'où l'on vient",
      "phrase": [
        "Ech kommen aus Frankräich.",
        "Je viens de France."
      ],
      "regle": "Pour beaucoup de pays, on utilise <b>aus</b> : ech kommen aus Frankräich, aus Portugal, aus Däitschland.",
      "exemple": "<b>Ech kommen</b> = je viens · <b>hien / si kënnt</b> = il / elle vient.",
      "pieges": [
        "On dit <b>aus Frankräich</b>, mais <b>vu Lëtzebuerg</b> : toutes les origines ne se disent pas avec aus.",
        "Le prénom ne change jamais entre le français et le luxembourgeois."
      ]
    },
    {
      "id": 2,
      "titre": "Les pays particuliers et la question",
      "phrase": [
        "Vu wou kënns du? – Ech kommen aus der Belsch.",
        "D'où viens-tu ? – Je viens de Belgique."
      ],
      "regle": "Pays particuliers : <b>vu Lëtzebuerg</b>, <b>aus der Belsch</b>, <b>aus der Schwäiz</b>, <b>aus dem Iran</b>, <b>vum Cap Vert</b>.",
      "exemple": "<b>Vu wou kënns du?</b> = D'où viens-tu ? · <b>Vu wou kommt Dir?</b> = D'où venez-vous ?",
      "pieges": [
        "<b>vu Lëtzebuerg</b> ≠ aus Lëtzebuerg.",
        "<b>aus der Belsch</b> et <b>aus der Schwäiz</b> : on conserve der."
      ]
    }
  ],
