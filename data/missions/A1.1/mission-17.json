      "locuteur": "apprenant",
      "lu": "Jo, um hallwer eelef ass gutt.",
      "fr": "Oui, dix heures et demie me convient."
    },
    {
      "ordre": 11,
      "locuteur": "interlocuteur",
      "lu": "Wéi ass Ären Numm?",
      "fr": "Quel est votre nom ?"
