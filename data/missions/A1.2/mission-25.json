      "ordre": 10,
      "locuteur": "apprenant",
      "lu": "Nee, merci.",
      "fr": "Non, merci."
    },
    {
      "ordre": 11,
      "locuteur": "interlocuteur",
      "lu": "Wëllt Dir eng Tut?",
      "fr": "Voulez-vous un sachet ?"
    },
    {
      "ordre": 12,
      "locuteur": "apprenant",
      "lu": "Jo, eng Tut, wann ech gelift.",
      "fr": "Oui, un sachet, s’il vous plaît."
    },
    {
      "ordre": 13,
      "locuteur": "interlocuteur",
      "lu": "Soss nach eppes?",
      "fr": "Autre chose ?"
